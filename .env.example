# Copy to .env on the 5070 Windows box and edit paths as needed.

# Absolute path to the CRAG Task 1/2 jsonl (~5GB raw; lite cache is built on first run).
CLOAK_CRAG_PATH=C:\data\crag\crag_task_1_and_2_dev_v4.jsonl

# Chat / vision models in Ollama
CLOAK_LLM_MODEL=qwen2.5:14b
CLOAK_VISION_MODEL=qwen2.5vl:7b
CLOAK_VISION=0

# Embeddings + rerank stay local (HF cache on disk)
CLOAK_EMBEDDING_MODEL=BAAI/bge-m3
CLOAK_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional: force CPU for embed/rerank (leave unset to auto-use CUDA)
# CLOAK_DEVICE=cpu

# After models are cached once:
# CLOAK_OFFLINE=1

# Retrieval recall knobs (defaults match the raise-retrieval-recall branch)
# CLOAK_TOP_DOCS=5
# CLOAK_RERANK_MIN_SCORE=0.20
# CLOAK_PARENT_TEXT_CHARS=3200
# CLOAK_MAX_CHUNK_CHARS=4000
# CLOAK_MAX_CONTEXT_CHARS=16000
# CLOAK_HTML_LIMIT=20000

OLLAMA_HOST=http://127.0.0.1:11434
